# Sao chép: cp .env.example .env

# --- JWT ---
JWT_SECRET_KEY=change_me
JWT_EXPIRE_MINUTES=1440

# --- PostgreSQL ---
POSTGRES_DB=lex_companion
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5444
POSTGRES_SSLMODE=disable

# --- MinIO ---
MINIO_HOST=localhost:6502
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_SECURE=false
# MINIO_BUCKET=lex-companion

# --- Redis / Valkey ---
REDIS_HOST=localhost
REDIS_PORT=6375
REDIS_PASSWORD=your_redis_password
LEX_TASK_STREAM=lex:tasks

# --- Elasticsearch ---
ELASTIC_HOST=localhost:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=
ELASTIC_INDEX=lex-companion-chunks
LEX_CHUNKS_INDEX=lex_chunks_v1
USER_DOCUMENTS_INDEX=user_documents
LEGAL_VECTOR_DIMS=1024
USER_DOC_CHUNK_TOKENS=2500
USER_DOC_CHUNK_OVERLAP_TOKENS=400
USER_DOC_CONTEXT_TOKEN_THRESHOLD=30000
RETRIEVAL_CONTEXT_MAX_TOKENS=128000
# TIKTOKEN_ENCODING=cl100k_base

# --- Rerank (FlagEmbedding bge-reranker-v2-m3) ---
RERANK_ENABLED=true
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_USE_FP16=true
RERANK_BATCH_SIZE=32
RERANK_MAX_QUERY_LENGTH=512
RERANK_MAX_LENGTH=512
RERANK_NORMALIZE=false
# RERANK_DEVICE=cuda:0

# --- LLM (OpenAI-compatible, e.g. local phi3) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:6511/v1
LLM_MODEL=phi3

# --- Embeddings ---
EMBEDDING_PROVIDER=localai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:6501/v1
EMBEDDING_MODEL=vietnamese-embedding

# --- Hugging Face admin import ---
HF_IMPORT_DEFAULT_LIMIT=50
HF_PREVIEW_SAMPLES_PER_CONFIG=20
