# Override cho Docker Compose — host nội bộ giữa các container.
# File này được load sau .env nên ghi đè POSTGRES_HOST, REDIS_HOST, ...

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MINIO_HOST=minio:9000

REDIS_HOST=redis
REDIS_PORT=6379

ELASTIC_HOST=elasticsearch:9200

EMBEDDING_BASE_URL=http://embedding:6501

GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback
